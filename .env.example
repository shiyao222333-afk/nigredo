# ============================================
# ⚗️ Alembic — 内容炼金蒸馏器 环境变量
# ============================================
# 复制此文件为 .env 并填入真实值

# === LLM API（兼容 OpenAI 格式）===
ALEMBIC_LLM_BASE_URL=https://api.deepseek.com/v1
ALEMBIC_LLM_API_KEY=sk-your-key-here
ALEMBIC_LLM_MODEL=deepseek-chat

# === B站 Cookie（用于高清下载 + API 鉴权）===
# 自动读取：程序会尝试从 Edge 浏览器自动提取
# 手动填写：SESSDATA=xxx; bili_jct=xxx; buvid3=xxx
BILIBILI_COOKIE=

# === 输出目录 ===
ALEMBIC_OUTPUT_DIR=./data/reports
ALEMBIC_CACHE_DIR=./data/cache

# === Qdrant（知炬联动）===
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_VIDEO=video_docs
QDRANT_COLLECTION_ANALYSIS=video_analysis

# === 调试 ===
ALEMBIC_DEBUG=false
